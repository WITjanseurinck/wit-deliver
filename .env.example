# Kopieer naar .env en vul in. .env komt nooit in git (zie .gitignore).

# Verplicht: willekeurige lange string, bv.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Inloggegevens voor /admin — alleen voor Jan/WIT, nooit voor klanten.
ADMIN_USER=jan
ADMIN_PASSWORD=

# Poort waarop het proces luistert (de reverse proxy stuurt hierheen door).
PORT=3300

# Zet dit op "production" zodra het achter https draait (reverse proxy) —
# dan staat de sessiecookie op "secure" en wordt hij nooit over plain http
# verstuurd.
NODE_ENV=production

# Waar data/db.json terechtkomt. Standaard ./data naast de broncode; zet dit
# buiten de repo-map als je liever niet dat een herinstallatie van de code
# de data overschrijft.
# DATA_DIR=/var/lib/wit-deliver
