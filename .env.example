# Kopieer naar .env en vul in voor lokaal draaien. .env komt nooit in git.
# In productie (Coolify) staan deze waarden als Environment Variables, zie DEPLOY.md.

# Verplicht: willekeurige lange string, bv.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Inloggegevens voor /admin — alleen voor Jan/WIT, nooit voor klanten.
ADMIN_USER=jan
ADMIN_PASSWORD=

# Poort waarop het proces luistert (de reverse proxy stuurt hierheen door).
PORT=3300

# Zet dit op "production" zodra het achter https draait (reverse proxy) —
# dan staat de sessiecookie op "secure" en wordt hij nooit over plain http
# verstuurd.
NODE_ENV=production

# Waar db.json terechtkomt. Standaard ./data naast de broncode. In productie:
# /data, het pad van het persistente volume in Coolify.
# DATA_DIR=/data
